DATABASE_URL=postgresql://fintrack:fintrack-local-only@localhost:55432/fintrack
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
MOBILE_AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
CRON_SECRET=replace-with-a-random-scheduler-secret
NEXT_PUBLIC_WEB_PUSH_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
# JSON service account for the Firebase project; keep private.
FIREBASE_SERVICE_ACCOUNT=

# Private server-side Cloudinary photo uploads (never NEXT_PUBLIC).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-side feedback notifications. Sender must be verified with Resend.
RESEND_API_KEY=
FEEDBACK_EMAIL_FROM=
FEEDBACK_EMAIL_TO=

# Activate after the capability-2 web and APK release is available.
FINANCE_REQUIRE_V2=false
